# URL del backend central (donde corre docker-compose.yml), alcanzable desde esta sede.
CENTRAL_API_BASE_URL=https://trace-monitor.example.com

# Clave del agente, generada una sola vez con:
#   curl -X POST $CENTRAL_API_BASE_URL/api/agents \
#     -H "Content-Type: application/json" \
#     -d '{"name":"Sucursal X","location":"Ciudad, Provincia","provider":"ISP local"}'
AGENT_API_KEY=tma_changeme

# Segundos entre cada ráfaga de mtr por destino, y cuántos paquetes manda cada ráfaga.
TRACE_INTERVAL_SECONDS=120
TRACE_REPORT_CYCLES=10
