POSTGRES_DB=trace_monitor
POSTGRES_USER=trace_monitor
POSTGRES_PASSWORD=changeme

# Segundos entre cada ráfaga de mtr por destino, y cuántos paquetes manda cada ráfaga.
TRACE_INTERVAL_SECONDS=120
TRACE_REPORT_CYCLES=10

# Puerto de la LAN donde queda publicado el dashboard.
FRONTEND_PORT=8080

# API key de Anthropic — SOLO se usa como fallback de una sola vez si la tabla de Settings esta
# vacia (se auto-migra a la DB en el primer analisis). Una vez migrada, administrala desde la
# pestaña Settings de la app; este valor puede quedar en blanco. Nunca commitear el valor real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Usuario admin inicial (solo se usa si la tabla Users esta vacia en el primer arranque —
# cambiar la contraseña por la UI de Settings apenas se loguea, despues se puede dejar en blanco).
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=changeme
